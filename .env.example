# ==============================================================================
# VideoStudio — Local Environment Configuration Example
# ==============================================================================
# Copy this file to `.env` (or run `./scripts/init-env.sh`) and replace all
# placeholder values with strong local secrets.
# NEVER commit `.env` to Git — this repository is PUBLIC.
# ==============================================================================

# --- Network & Web Access (LAN) ---
# Port exposed on your Debian server to access the Studio UI, API, WS & MCP
STUDIO_PORT=3100
NODE_ENV=production

# Comma-separated list of allowed browser origins, or "*" for trusted LAN use
CORS_ORIGIN=*

# --- PostgreSQL (isolated inside Docker internal network) ---
POSTGRES_DB=videostudio
POSTGRES_USER=videostudio
POSTGRES_PASSWORD=change-me-use-a-strong-random-password

# Used by the backend container (matches docker-compose service name `postgres`)
DATABASE_URL=postgresql://videostudio:change-me-use-a-strong-random-password@postgres:5432/videostudio

# --- MCP Server Security (Claude Code <-> VideoStudio) ---
# Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=change-me-generate-with-openssl-rand-hex-32

# --- Media Storage & ComfyUI LAN Ingestion ---
# Path inside container where media originals/proxies/thumbnails are persisted
DATA_DIR=/data

# Maximum upload size in MB (default: 2048 MB = 2 GB)
MAX_UPLOAD_MB=2048

# Optional comma-separated list of allowed LAN hostnames/IPs for URL ingestion
# Example: 192.168.1.50:8188,comfy-pc.local:8188
# Leave empty to allow private LAN RFC1918/localhost fetches (cloud metadata IPs are always blocked)
ALLOWED_FETCH_HOSTS=

# Optional host directory mounted read-only for local file path ingestion via MCP
INGEST_ALLOWED_DIR=/ingest

# Directory synced with Claude Code skills (SKILL.md files)
SKILLS_SYNC_DIR=/skills
